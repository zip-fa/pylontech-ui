{
  "name": "daemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node --experimental-strip-types --watch src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.sqlite.config.ts && drizzle-kit generate --config=drizzle.mysql.config.ts && drizzle-kit generate --config=drizzle.postgres.config.ts"
  },
  "dependencies": {
    "@libs/protocol": "*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "mysql2": "^3.24.2",
    "pg": "^8.23.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/pg": "^8.23.1"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
